# KL5n NFC (NXP PN553) — HAND-WRITTEN, not generated by extract-files.
# Inherited by device/tecno/KL5/device.mk only when
# SOONG_CONFIG_tecno_camera_camera_variant = kl5n (set in lineage_KL5n.mk).
#
# KL5 builds never see this file, so the KL5 image is unchanged.
#
# How the stack fits together (reference: xiaomi gale device tree, which
# uses the same Lineage NXP snxxx stack):
#   * HAL: android.hardware.nfc-service.nxp built from Lineage source
#     (hardware/nxp/nfc, provided by the LineageOS global manifest — same
#     as gale, so no lineage.dependencies change).  Its nfc_nci_nxp_snxxx
#     NCI library is ALSO built from source; only firmware/conf files come
#     from stock.  The service ships its own init rc + vintf fragment
#     (declares android.hardware.nfc + vendor.nxp.nxpnfc_aidl), so the
#     stock android.hardware.nfc_snxxx@1.2-service rc/binary must NOT be
#     shipped (would clash on service name vendor.nfc_hal_service).
#   * Device node /dev/pn553 is created by nfc_i2c.ko (already in
#     modules.load.vendor for both variants); perms handled by stock
#     init.nxp.nfc.rc + ueventd.mt6768.rc.
#   * The source HAL reads /vendor/etc/libnfc-nxp.conf (NXP_NFC_DEV_NODE=
#     /dev/pn553, NXP_FW_NAME=libpn557_fw.so), /vendor/etc/libnfc-nci.conf,
#     /vendor/libnfc-nxp_RF.conf (halimpl hardcodes that path) and
#     /vendor/etc/libnfc-slm.conf.
#

PRODUCT_PACKAGES += \
    android.hardware.nfc-service.nxp \
    com.android.nfc_extras \
    Tag

# AOSP feature permissions (stock installs these under vendor/etc/permissions)
PRODUCT_COPY_FILES += \
    frameworks/native/data/etc/android.hardware.nfc.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.nfc.xml \
    frameworks/native/data/etc/android.hardware.nfc.hce.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.nfc.hce.xml \
    frameworks/native/data/etc/com.android.nfc_extras.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/com.android.nfc_extras.xml

# Stock KL5n NFC config / firmware / init / vendor feature permissions
PRODUCT_COPY_FILES += \
    vendor/tecno/KL5/proprietary_kl5n/vendor/etc/libnfc-nci.conf:$(TARGET_COPY_OUT_VENDOR)/etc/libnfc-nci.conf \
    vendor/tecno/KL5/proprietary_kl5n/vendor/etc/libnfc-nxp.conf:$(TARGET_COPY_OUT_VENDOR)/etc/libnfc-nxp.conf \
    vendor/tecno/KL5/proprietary_kl5n/vendor/etc/libnfc-slm.conf:$(TARGET_COPY_OUT_VENDOR)/etc/libnfc-slm.conf \
    vendor/tecno/KL5/proprietary_kl5n/vendor/libnfc-nxp_RF.conf:$(TARGET_COPY_OUT_VENDOR)/libnfc-nxp_RF.conf \
    vendor/tecno/KL5/proprietary_kl5n/vendor/etc/init/init.nxp.nfc.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/init.nxp.nfc.rc \
    vendor/tecno/KL5/proprietary_kl5n/vendor/lib64/libpn557_fw.so:$(TARGET_COPY_OUT_VENDOR)/lib64/libpn557_fw.so \
    vendor/tecno/KL5/proprietary_kl5n/vendor/etc/permissions/com.nxp.nfc.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/com.nxp.nfc.xml \
    vendor/tecno/KL5/proprietary_kl5n/vendor/etc/permissions/com.nxp.mifare.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/com.nxp.mifare.xml \
    vendor/tecno/KL5/proprietary_kl5n/vendor/etc/permissions/com.nxp.ls.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/com.nxp.ls.xml
