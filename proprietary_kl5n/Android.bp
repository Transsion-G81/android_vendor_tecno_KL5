// clang-format off
//
// KL5n (imx582) camera blobs — HAND-WRITTEN, not generated by extract-files.
// Never touched by `extract-files.py --regenerate_makefiles` (which only
// rewrites the root Android.bp / KL5-vendor.mk / Android.mk).
//
// These two libs are DT_NEEDED by the KL5n libcameracustom.so
// (proprietary_kl5n/vendor/lib64/libcameracustom.so).  They are dlopened
// via SensorInfoIdxMgr<id>::impGetDefaultData at camera HAL bring-up.
//

cc_prebuilt_library_shared {
    name: "imx582_mipi_raw_IdxMgr",
    owner: "tecno",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: [
                "vendor/lib64/imx582_mipi_raw_IdxMgr.so",
            ],
            shared_libs: [
                "liblog",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    prefer: true,
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "pblcimx582_mipi_raw_IdxMgr",
    owner: "tecno",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: [
                "vendor/lib64/pblcimx582_mipi_raw_IdxMgr.so",
            ],
            shared_libs: [
                "liblog",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    prefer: true,
    soc_specific: true,
}

// dlopen'ed camera tuning / HDR-adapter blobs + NXP NFC firmware blob.
// Shipped as prebuilts instead of PRODUCT_COPY_FILES because the build
// rejects ELF files in copy files (check-non-elf-file).  Not linked by
// anything in the build graph, so check_elf_files is disabled.
cc_prebuilt_library_shared {
    name: "imx582_mipi_raw_tuning",
    owner: "tecno",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: [
                "vendor/lib64/imx582_mipi_raw_tuning.so",
            ],
        },
    },
    check_elf_files: false,
    compile_multilib: "64",
    prefer: true,
    soc_specific: true,
}

cc_prebuilt_library_shared {
